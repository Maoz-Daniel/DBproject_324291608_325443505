# Ignore Python cache files
__pycache__/
*.py[cod]
*.pyo

# Ignore virtual environment
venv/

# Ignore environment variable files
.env

# Ignore VSCode settings (optional)
.vscode/

# Ignore compiled C extensions
*.so

# Ignore Jupyter Notebook checkpoints (if you use them)
.ipynb_checkpoints/

# Ignore SQLite databases (if you have any local db files)
*.sqlite3
*.db

# Ignore logs (if any)
*.log

# Ignore OS-specific files
.DS_Store
Thumbs.db
